import java.util.Scanner;

public class Reggie {
    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);

        String ssn;
        String mNumber;
        String zipCode;

        ssn = SafeInput.getRegExString(in, "Enter your SSN", "\\d{3}-\\d{2}-\\d{4}");

        mNumber = SafeInput.getRegExString(in, "Enter your UC student M number", "(M|m)\\d{5}");

        zipCode = SafeInput.getRegExString(in, "Enter your Zip+4 code", "\\d{5}-\\d{4}");

        System.out.println("\nSSN: " + ssn);
        System.out.println("M Number: " + mNumber);
        System.out.println("Zip+4: " + zipCode);
    }
}
