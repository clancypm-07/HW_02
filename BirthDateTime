import java.util.Scanner;

public class BirthDateTime
{
    public static void main(String[] args)
    {
        Scanner in = new Scanner(System.in);

        int year;
        int month;
        int day;
        int hour;
        int minute;
        int maxDays;

        year = SafeInput.getRangedInt(in, "Enter birth year", 1921, 2020);
        month = SafeInput.getRangedInt(in, "Enter birth month", 1, 12);

        if (month == 2)
        {
            maxDays = 29;
        } else if (month == 4 || month == 6 || month == 9 || month == 11)
        {
            maxDays = 30;
        } else {
            maxDays = 31;
        }

        day = SafeInput.getRangedInt(in, "Enter birth day", 1, maxDays);
        hour = SafeInput.getRangedInt(in, "Enter birth hour", 1, 24);
        minute = SafeInput.getRangedInt(in, "Enter birth minute", 1, 59);

        System.out.println("\nBirth Date and Time: ");
        System.out.println(month + "/" + day + "/" + year);
        System.out.printf("%d:%02d\n", hour, minute);
    }
}
